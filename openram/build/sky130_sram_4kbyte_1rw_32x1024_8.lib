library (sky130_sram_4kbyte_1rw_32x1024_8__fallback_lib) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  leakage_power_unit : "1mW";
  capacitive_load_unit (1,pf);
  nom_voltage : 1.8;
  nom_temperature : 25;
  nom_process : 1;

  /* Threshold definitions required by OpenSTA */
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;

  operating_conditions(TT_1p8V_25C) { process : 1; voltage : 1.8; temperature : 25; }
  default_operating_conditions : TT_1p8V_25C;

  type(data) { base_type : array; data_type : bit; bit_width : 32; bit_from : 31; bit_to : 0; }
  type(addr) { base_type : array; data_type : bit; bit_width : 11; bit_from : 10; bit_to : 0; }
  type(wmask) { base_type : array; data_type : bit; bit_width : 4; bit_from : 3; bit_to : 0; }

  cell (sky130_sram_4kbyte_1rw_32x1024_8) {
    area : 1;
    memory() { type : ram; address_width : 11; word_width : 32; }
    bus(din0) { bus_type : data; direction : input; }
    bus(dout0) { bus_type : data; direction : output; }
    bus(addr0) { bus_type : addr; direction : input; }
    bus(wmask0) { bus_type : wmask; direction : input; }
    pin(clk0) { direction : input; clock : true; }
    pin(csb0) { direction : input; }
    pin(web0) { direction : input; }
    pin(spare_wen0) { direction : input; }
    pg_pin(vccd1) { voltage_name : VCCD1; pg_type : primary_power; }
    pg_pin(vssd1) { voltage_name : VSSD1; pg_type : primary_ground; }
  }
}
